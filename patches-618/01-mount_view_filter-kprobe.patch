+/*
+ * kprobe fallback for the open-slot patch.
+ *
+ * Some vendor kernels write protect proc_mounts_operations and friends (the page is
+ * mapped read-only at EL2, so ksu_patch_text() fails with -EFAULT). Hooking the original
+ * open function and pointing the PC at our wrapper gives the same effect; the kprobe
+ * leaves x30 alone, so the wrapper's return goes straight back to the caller.
+ *
+ * The wrapper calls original_open, which trips the same probe again: mark the task while
+ * that call is in flight (see ksu_mvf_call_open) and let the nested hit run the original.
+ */
+static DEFINE_XARRAY(ksu_mvf_tasks);
+
+static bool ksu_mvf_task_marked(void)
+{
+    return xa_load(&ksu_mvf_tasks, (unsigned long)current) != NULL;
+}
+
+static void ksu_mvf_task_mark(void)
+{
+    xa_store(&ksu_mvf_tasks, (unsigned long)current, xa_mk_value(1), GFP_ATOMIC);
+}
+
+static void ksu_mvf_task_clear(void)
+{
+    xa_erase(&ksu_mvf_tasks, (unsigned long)current);
+}
+
+#if defined(__aarch64__)
+#define ksu_mvf_set_pc(regs, addr) ((regs)->pc = (unsigned long)(addr))
+#elif defined(__x86_64__)
+#define ksu_mvf_set_pc(regs, addr) ((regs)->ip = (unsigned long)(addr))
+#elif defined(__riscv)
+#define ksu_mvf_set_pc(regs, addr) ((regs)->epc = (unsigned long)(addr))
+#endif
+
+static int ksu_mvf_kprobe_pre(struct kprobe *kp, struct pt_regs *regs)
+{
+    struct ksu_mvf_hook *hook = container_of(kp, struct ksu_mvf_hook, kp);
+
+    if (!smp_load_acquire(&ksu_mvf_enabled))
+        return 0;
+
+    /* system uids are never filtered, so their opens do not need the detour */
+    if (likely(current_uid().val < 10000))
+        return 0;
+
+    if (ksu_mvf_task_marked())
+        return 0;
+
+    if (!hook->replacement)
+        return 0;
+
+    ksu_mvf_set_pc(regs, hook->replacement);
+
+    return 1;
+}
